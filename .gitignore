# Dependencies
node_modules/

# Build output
dist/
*.tsbuildinfo

# Test / coverage
coverage/
.vitest/

# Local data — derived from gated/licensed datasets (NextMe-800 CC BY-NC, Ego4D, Ego-Exo4D).
# Never commit: raw annotations, normalized catalog, timelines, exported manifests.
# Exception: data/distributions/ holds ATUS outputs (US public-domain survey data), committed so new servers work after clone.
data/*
!data/distributions/

# Python helper (HD-EPIC pkl conversion)
__pycache__/
*.pyc
.venv/

# Secrets
.env
.env.*
!.env.example

# Logs / OS / editor
*.log
npm-debug.log*
.DS_Store
.idea/
.vscode/

